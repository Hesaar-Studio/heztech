# ==============================================================================
# HezTech (هستک) — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR TOKENS TO SOURCE CONTROL.
# Secrets are encrypted at runtime via OS Credential Store (Windows DPAPI).
# ==============================================================================

# Application Environment
NODE_ENV=production
HEZTECH_PORT=8000
HEZTECH_HOST=127.0.0.1

# AI Model Provider Keys (Optional — local offline engine active by default)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Storage Paths
# HEZTECH_DATA_DIR=C:\Users\YourUser\AppData\Roaming\HezTech
# HEZTECH_CAPCUT_BRIDGE_DIR=C:\Users\YourUser\openclaw\capcut-bridge-kit

# External Tool Catalog & MCP (Treg)
# HEZTECH_TREG_BASE_URL=https://treg.to
# TREG_API_KEY=your_treg_api_token_here

# Social & Messaging Integrations (Stored securely in OS vault)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# META_APP_ID=your_meta_app_id_here
# YOUTUBE_CLIENT_ID=your_google_oauth_client_id_here
# YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Local Media Processing (FFmpeg/FFprobe binaries)
# HEZTECH_FFMPEG=ffmpeg
# HEZTECH_FFPROBE=ffprobe
# HEZTECH_PYTHON=python
